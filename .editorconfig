# EditorConfig — https://editorconfig.org
#
# Template. Every section below is here for a reason, not for symmetry:
# either a format REQUIRES the setting, or a convention is strong enough
# that fighting it creates diff noise. Prune what a project doesn't use.
#
# Only these properties are standard: indent_style, indent_size, tab_width,
# end_of_line, charset, trim_trailing_whitespace, insert_final_newline,
# max_line_length, root. Anything else is editor-specific (see BBEdit at
# the bottom). Unknown keys are ignored, so they are safe to commit.
#
# Any property can be set to `unset` to fall back to the editor's own
# default instead of inheriting from a broader section.

root = true

# ---------------------------------------------------------------------
# Baseline
# ---------------------------------------------------------------------

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# ---------------------------------------------------------------------
# Formats where the setting is REQUIRED — getting these wrong breaks
# the file, it is not a style disagreement
# ---------------------------------------------------------------------

# make requires tabs for recipe lines; spaces make the file fail to run
[{Makefile,makefile,GNUmakefile,*.mk,*.make}]
indent_style = tab
indent_size = tab
tab_width = 4

# YAML forbids tabs entirely — a tab is a parse error, not a preference
[*.{yml,yaml}]
indent_style = space

# Terminfo source uses tabs
[*.terminfo]
indent_style = tab
indent_size = tab

# Windows tooling expects CRLF; LF can break label/goto handling
[*.{bat,cmd,ps1xml}]
end_of_line = crlf

# Visual Studio rewrites solution files as CRLF + tabs on every save
[*.sln]
end_of_line = crlf
indent_style = tab
indent_size = tab

# Trailing whitespace is part of the payload in a patch — trimming it
# corrupts the context lines and the patch stops applying
[*.{diff,patch}]
trim_trailing_whitespace = false
insert_final_newline = false

# ---------------------------------------------------------------------
# Formats where whitespace carries meaning
# ---------------------------------------------------------------------

# Two trailing spaces are a hard line break in Markdown. Trimming them
# silently reflows published prose.
[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = off

# Prose generally: let it soft-wrap rather than hard-wrap
[*.{txt,rst,adoc,asciidoc}]
max_line_length = off

# Git's own convention: 50-char subject, 72-char body
[{COMMIT_EDITMSG,MERGE_MSG,TAG_EDITMSG}]
max_line_length = 72
trim_trailing_whitespace = false

# ---------------------------------------------------------------------
# Language conventions — follow each toolchain's formatter so the
# formatter and the editor do not fight each other
# ---------------------------------------------------------------------

# gofmt is non-negotiable and uses tabs
[*.go]
indent_style = tab
indent_size = tab
tab_width = 4

# PEP 8
[*.{py,pyi}]
indent_size = 4
max_line_length = 88

# rustfmt
[*.rs]
indent_size = 4
max_line_length = 100

# PSR-12
[*.php]
indent_size = 4

[*.{c,h,cpp,hpp,cc,cxx,m,mm}]
indent_size = 4

[*.{java,kt,kts,gradle,scala,groovy}]
indent_size = 4

[*.{cs,vb,fs,fsx}]
indent_size = 4

[*.{swift,ps1,psm1,psd1}]
indent_size = 4

[*.{sh,bash,zsh,fish,ksh}]
indent_size = 2

# Prettier's default, and the ecosystem norm
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,json5,vue,svelte,astro}]
indent_size = 2

[*.{html,htm,xhtml,xml,svg,css,scss,sass,less,styl}]
indent_size = 2

[*.{toml,ini,cfg,conf,properties,env}]
indent_size = 2

[*.{tf,tfvars,hcl,nomad}]
indent_size = 2

[*.{rb,rake,gemspec,erb,haml,slim}]
indent_size = 2

[*.{lua,el,vim,ex,exs,erl,hrl,clj,cljs,edn}]
indent_size = 2

[*.{sql,graphql,gql,proto,cue}]
indent_size = 2

[*.{tmpl,gotmpl,gohtml,j2,jinja,jinja2,hbs,mustache,twig,liquid}]
indent_size = 2

[*.{dockerfile,Dockerfile,containerfile}]
indent_size = 2

[{Dockerfile,Containerfile,Vagrantfile,Brewfile,Justfile,justfile,Procfile}]
indent_size = 2

# Git's own config files use tabs by convention
[{.gitconfig,.gitmodules,config.tmpl}]
indent_style = tab
indent_size = tab

# ---------------------------------------------------------------------
# Do not touch — generated, vendored, or byte-compared files.
# Reformatting these produces noise at best and test failures at worst.
# ---------------------------------------------------------------------

[{package-lock.json,yarn.lock,pnpm-lock.yaml,bun.lockb,composer.lock,Gemfile.lock,poetry.lock,Cargo.lock,go.sum,flake.lock}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Only names that are third-party or generated BY CONVENTION belong here.
# `build/`, `dist/`, `out/`, `target/` are deliberately absent: those names
# are project choices, not guarantees. `build/` is CMake output in one repo
# and hand-written scripts in the next, and unsetting a directory of real
# source silently drops it out of the house style. Add them per project,
# where you know which it is — and note that genuine output is usually
# gitignored, so it rarely needs a rule at all.
[{**/vendor/**,**/node_modules/**,**/third_party/**,**/*.min.*}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Snapshot and fixture files are compared byte for byte
[**/{__snapshots__,testdata,fixtures,golden}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

# Upstream boilerplate — leave it as the project published it
[{LICENSE,LICENSE.*,COPYING,NOTICE,CHANGELOG.md,CODE_OF_CONDUCT.md}]
indent_size = unset
max_line_length = off

# ---------------------------------------------------------------------
# chezmoi source files
#
# In a chezmoi source directory the on-disk names are prefixed and the
# real extension is often hidden, so extension globs above will not
# match them. These sections restore the intended settings.
# https://www.chezmoi.io/reference/source-state-attributes/
# ---------------------------------------------------------------------

# dot_zshrc, private_dot_bashrc, executable_dot_profile, ...
[**/{dot_,private_dot_,executable_dot_,readonly_dot_}*]
indent_style = space
indent_size = 2

# chezmoi templates take the settings of the file they generate
[*.tmpl]
indent_size = 2

# Encrypted sources are ciphertext — never reformat them
[*.age]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# ---------------------------------------------------------------------
# BBEdit-specific keys
# https://www.barebones.com/support/technotes/editorconfig.html
#
# Every other editor ignores unknown keys, so these cost nothing to
# commit. A second [*] section is legal — sections merge, later values
# win — which keeps the editor-specific block separable from the
# standard one above.
#
# Unless noted, these are Boolean flags (1 / 0):
#   x-soft-wrap-text        Soft Wrap Text
#   x-soft-wrap-mode        CharacterWidth | WindowWidth | PageGuide
#   x-soft-wrap-limit       integer; character count, and only meaningful
#                           when x-soft-wrap-mode = CharacterWidth
#   x-show-invisibles       Show Invisibles
#   x-show-spaces           Show Spaces
#   x-typographers-quotes   Use Typographer's Quotes
#   x-balance-while-typing  Balance While Typing
#   x-font-name             string
#   x-font-size             integer
# ---------------------------------------------------------------------

[*]
x-soft-wrap-text = 1
x-soft-wrap-mode = WindowWidth
x-show-invisibles = 1
x-show-spaces = 1

# Straight quotes in code and config, always — smart quotes here are a
# syntax error waiting to happen
[*.{md,markdown,txt}]
x-typographers-quotes = 1
